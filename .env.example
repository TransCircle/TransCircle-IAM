# 复制为 .env 并按你的环境修改。
# 注意：前端已内嵌进应用容器，单容器同端口同时提供 UI 与 API；对外反向代理由你们
# 已有的 nginx 负责，只需反代 app 的 ${APP_PORT} 出口即可。

# --- 对外公开地址（OIDC issuer）---
# 必须是用户浏览器访问的最终地址（即你们 nginx 对外的域名/URL）。
# 生产环境请填 HTTPS 域名，例如 https://iam.transcircle.com
IAM_ISSUER=http://localhost

# 运行模式：dev | prod。prod 会强制 Secure Cookie 并隐藏详细错误。
IAM_ENV=dev
# 留空=dev(http)；生产经 HTTPS 反代时填 "true"。
IAM_COOKIE_SECURE=

# 应用对外暴露的端口（host:8080），即你们 nginx 反代的唯一出口。
APP_PORT=8080

# --- 数据库 / 缓存 ---
# 数据持久化在当前目录 ./data/ 下（postgres / redis / app），随仓库目录可见可备份。
POSTGRES_USER=iam
POSTGRES_PASSWORD=请修改-postgres密码
POSTGRES_DB=iam
REDIS_PASSWORD=请修改-redis密码

# 仅列出真正反向代理的 IP/CIDR，逗号分隔。留空时应用忽略所有 X-Forwarded-*。
# nginx 与 app 同 Docker 网络时可填 nginx 容器所在的固定网段；不要使用 0.0.0.0/0。
IAM_TRUSTED_PROXIES=
# --- 可选：KEK 加固（默认关闭）---
# 开启后，数据加密密钥(DEK)将被此 KEK 包裹保存，而非明文入库。
# 生成方式：openssl rand -base64 32
IAM_KEK_ENABLED=
# 二选一：直接给 IAM_KEK(base64)，或指向一个密钥文件（docker secret）：
# IAM_KEK_FILE=/run/secrets/iam_kek

# 镜像版本号（写入 /version）。
VERSION=dev
